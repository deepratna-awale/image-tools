# Application Settings
APP_NAME="Image Processing API"
APP_VERSION="1.0.0"
DEBUG=true
LOG_LEVEL=INFO

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# Queue Configuration (rabbitmq or sqs)
QUEUE_TYPE=rabbitmq
RABBITMQ_URL=amqp://guest:guest@localhost/

# Storage Configuration (local or s3)
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./uploads

# AWS Configuration (for production)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET_NAME=your-image-processing-bucket
S3_RESULTS_BUCKET=your-results-bucket
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/account/queue-name

# Security
SECRET_KEY=your-secret-key-change-in-production

# Processing Configuration
MAX_FILE_SIZE=10485760  # 10MB
JOB_RESULT_TTL=3600     # 1 hour
WORKER_CONCURRENCY=1

# Public API for other apps (see docs/API.md)
API_KEYS=
API_RATE_LIMIT_PER_MINUTE=20
API_POLL_LIMIT_PER_MINUTE=300

# CORS: browser origins allowed to call the API directly (comma-separated or JSON)
ALLOWED_ORIGINS=
