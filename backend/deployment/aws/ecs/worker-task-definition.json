{
  "family": "image-processing-worker",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "2048",
  "memory": "4096",
  "executionRoleArn": "arn:aws:iam::YOUR_ACCOUNT:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::YOUR_ACCOUNT:role/imageProcessingTaskRole",
  "containerDefinitions": [
    {
      "name": "worker-container",
      "image": "YOUR_ECR_REPO/image-processing-worker:latest",
      "environment": [
        {
          "name": "QUEUE_TYPE",
          "value": "sqs"
        },
        {
          "name": "STORAGE_TYPE",
          "value": "s3"
        },
        {
          "name": "AWS_REGION",
          "value": "us-east-1"
        },
        {
          "name": "LOG_LEVEL",
          "value": "INFO"
        },
        {
          "name": "WORKER_CONCURRENCY",
          "value": "2"
        }
      ],
      "secrets": [
        {
          "name": "S3_BUCKET_NAME",
          "valueFrom": "arn:aws:ssm:us-east-1:YOUR_ACCOUNT:parameter/image-processing/s3-bucket"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/image-processing-worker",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "command": ["python", "-m", "workers.image_processor"]
    }
  ]
}
