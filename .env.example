# Copy to .env and fill in before `docker compose up -d --build`

# Required: RabbitMQ credentials, shared by rabbitmq, api and worker.
# Pick a strong password; never commit the real .env.
RABBITMQ_DEFAULT_USER=imagetools
RABBITMQ_DEFAULT_PASS=

# Hostname for HTTPS when using docker-compose.https.yml (Caddy gets the certificate).
# deploy/oracle/setup.sh fills this in with <public-ip>.sslip.io if you don't have a domain.
# SITE_ADDRESS=image-tools.example.com

# Published ports
FRONTEND_PORT=3000
API_PORT=8000

LOG_LEVEL=INFO

# Upload limit per file, in bytes (default 10MB)
# MAX_FILE_SIZE=10485760

# Public background-removal API for other apps, at https://<SITE_ADDRESS>/api/v1/background-removal
# (see docs/API.md). Create and revoke keys at https://<SITE_ADDRESS>/api-keys with this token
# (deploy/oracle/setup.sh generates one; or `openssl rand -hex 24`). Empty disables that page.
# ADMIN_TOKEN=
# Optional extra keys, comma-separated, that work alongside the ones made on the page.
# With no keys at all the public API refuses every request; the site itself keeps working.
# API_KEYS=
# Per key per minute: job submissions, and status/result requests
# API_RATE_LIMIT_PER_MINUTE=20
# API_POLL_LIMIT_PER_MINUTE=300
# Images per UTC day: default per key, and for all keys together (the hard ceiling)
# API_DAILY_LIMIT_PER_KEY=200
# API_DAILY_LIMIT_TOTAL=1000
# API_MAX_KEYS=20
# Self-serve keys anyone can create on /api-keys (API_PUBLIC_SIGNUP=false turns that off).
# Per key per day, all self-serve keys together per day (inside the total above),
# submissions per minute, and sign-up limits per network address and overall.
# API_PUBLIC_SIGNUP=true
# API_PUBLIC_DAILY_LIMIT_PER_KEY=50
# API_PUBLIC_DAILY_LIMIT_TOTAL=300
# API_PUBLIC_RATE_LIMIT_PER_MINUTE=5
# API_PUBLIC_KEYS_PER_IP_PER_DAY=3
# API_PUBLIC_ACTIVE_KEYS_PER_IP=5
# API_PUBLIC_SIGNUPS_PER_DAY=100
# API_PUBLIC_MAX_KEYS=2000

# Browser origins allowed to call the API directly (comma-separated). Only needed when a
# web page calls it from the browser; server-to-server calls and this site need no entry.
# ALLOWED_ORIGINS=https://my-other-app.example

# Optional: S3 storage instead of the local volume.
# Job status tracking still uses the shared storage volume, so keep api and worker on one host.
# STORAGE_TYPE=s3
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=
# S3_RESULTS_BUCKET=
